<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

    <!-- Symptom Question -->
    <TextView
        android:id="@+id/symptomText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Symptom Question Placeholder"
        android:textColor="@android:color/black"
        android:textSize="18sp" />


    <Button
        android:id="@+id/symptomImageToggleButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Image"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="@drawable/button_background"
        android:textColor="@android:color/white" />

    <ImageView
        android:id="@+id/symptomImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:visibility="gone"
        android:src="@drawable/logo" />
    <RadioGroup
        android:id="@+id/symptomRadioGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:layout_gravity="center">

        <RadioButton
            android:id="@+id/symptomYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes" />

        <RadioButton
            android:id="@+id/symptomNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No" />
    </RadioGroup>

</LinearLayout>
