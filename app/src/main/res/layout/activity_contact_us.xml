<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:id="@+id/aboutUsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About Us"
            android:textColor="@android:color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>


        <TextView
            android:id="@+id/aboutUsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We are a dedicated team working on providing cattle disease prediction services through an innovative mobile application.Our application get the inputs from the user and will predict the cattle disease. "
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="24dp"/>


        <TextView
            android:id="@+id/teamSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meet Our Team"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/teamMember1Image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="16dp"
                android:scaleType="centerCrop"
                android:src="@drawable/babu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/teamMember1Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abdul Islam"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/teamMember1Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cattle can show early symptoms of disease through changes in behavior, which our app can detect!"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@android:color/black"/>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/teamMember2Image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/emaan"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="16dp"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/teamMember2Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eman Fatima "
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/teamMember2Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Machine learning models can predict diseases in cattle as accurately as experienced veterinarians!"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@android:color/black"/>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/teamMember3Image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/jabar"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="16dp"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/teamMember3Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jabar Ali"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/teamMember3Info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A well-timed prediction can save farmers thousands by preventing widespread disease outbreaks."
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@android:color/black"/>
            </LinearLayout>
        </LinearLayout>


        <TextView
            android:id="@+id/contactUsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Us"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/contactUsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For any inquiries or support, please reach out to us via the following channels:"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email: 21101003-097@uskt.edu.pk"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone: +123 456 7890"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address: 1-Km Main, Daska Rd, Sialkot, Punjab 51040
University of Sialkot"
                android:textSize="16sp"
                android:textColor="@android:color/black"/>
        </LinearLayout>

        <Button
            android:id="@+id/homeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:layout_gravity="center_horizontal"
            android:textColor="@android:color/white"
            android:background="@drawable/button_background"
            android:layout_marginTop="14dp"
            android:padding="12dp"
            />

    </LinearLayout>
</ScrollView>
